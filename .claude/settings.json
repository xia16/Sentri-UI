{
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": { "source": "git", "url": "https://github.com/xia16/adam-agent-workflow.git", "ref": "pocock-pristine" }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|.*auto_merge.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/merge-guard.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking the merge guard"
          }
        ]
      }
    ]
  }
}
