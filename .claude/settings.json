{
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "settings",
        "name": "mattpocock",
        "plugins": [
          {
            "name": "mattpocock-skills",
            "source": { "source": "github", "repo": "mattpocock/skills", "ref": "main", "sha": "49dd158d1076134a641b33efb035946536778336" }
          }
        ]
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|.*auto_merge.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/merge-guard.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking the merge guard"
          }
        ]
      }
    ]
  }
}
