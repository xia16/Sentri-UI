{
  "feature": "health-record",
  "defaults": { "url": "/ux/system/inspection-astra-concept.html?layout=focus", "clock": "2026-09-12T09:41:00",
                "langs": ["en", "zh"], "widths": [360, 390], "height": 844, "clipCheck": true },
  "tree": [
    {
      "type": "entry", "id": "hr-t.entry", "label": "Record treatment for several pigs (two selected)",
      "children": [
        {
          "type": "state", "id": "hr-t.state", "label": "Record treatment for two pigs, Tulathromycin picked, no dosage yet", "tree": "T",
          "reset": { "screen": "health-record.treatment-batch" },
          "children": [
            {
              "type": "outcome", "id": "hr-t1-save-waits-for-dose", "tree": "T-1",
              "label": "Save waits until a dose is set, and no Adjust row shows before a dosage",
              "gwt": { "given": "A worker recording a treatment for two pigs has picked the medicine but typed no dosage.",
                       "when": "They look at the form.",
                       "then": "Save is waiting, and there is no row offering to adjust the doses." },
              "authority": [
                { "src": "PRD", "at": "features/medicines, Hosts: Save", "says": "Save waits until the shared dose is set, or every included pig has a typed dose." },
                { "src": "PRD", "at": "features/medicines, Hosts: several pigs", "says": "no dosage, no row" }
              ],
              "visible": [
                { "screen": "health-record.treatment-batch" },
                { "el": "[data-action=\"bulk-save\"]", "is": "disabled", "says": "Save is waiting" },
                { "el": "[data-action=\"pig-doses-open\"]", "is": "absent", "says": "no Adjust row" }
              ]
            },
            {
              "type": "action", "id": "hr-t2.dose", "label": "Type a dosage of 2.5",
              "taps": [{ "fill": "[data-bulk-key=\"dose\"]", "value": "2.5" }],
              "children": [
                {
                  "type": "outcome", "id": "hr-t2-shared-dose-row", "tree": "T-2",
                  "label": "One dosage applies to every pig: one row says so and offers Adjust; Save counts the pigs",
                  "gwt": { "given": "A worker is recording a treatment for two pigs.",
                           "when": "They type a dosage of 2.5.",
                           "then": "A row reads 2 pigs at 2.5 mL each with Adjust, and Save is ready for both pigs." },
                  "authority": [
                    { "src": "PRD", "at": "features/medicines, Hosts: several pigs", "says": "Once a dosage is typed, one navigate row under it reads \"2 pigs · 2.5 mL each\" with \"Adjust ›\"" }
                  ],
                  "visible": [
                    { "text": { "en": "2 pigs · 2.5 mL each", "zh": "2 头 · 每头 2.5 mL" }, "in": "sheet" },
                    { "el": "[data-action=\"bulk-save\"]", "is": "enabled", "says": "Save is ready" },
                    { "text": "Save · 2 pigs", "in": "sheet" }
                  ]
                },
                {
                  "type": "action", "id": "hr-t3.adjust", "label": "Tap the row, give 000254 its own dose of 3, then Back",
                  "taps": ["[data-action=\"pig-doses-open\"]", { "fill": "[data-bulk-value=\"000254\"]", "value": "3" }, "[data-action=\"back\"]"],
                  "children": [
                    {
                      "type": "outcome", "id": "hr-t3-one-pig-adjusted", "tree": "T-3",
                      "label": "A pig's own dose is kept and the form counts it as adjusted",
                      "gwt": { "given": "A worker set a dosage of 2.5 for two pigs.",
                               "when": "On Dose per pig they give one pig 3 and go back.",
                               "then": "The form's row reads 2 pigs with 1 adjusted, and Save is still ready for both." },
                      "authority": [
                        { "src": "PRD", "at": "features/medicines, Hosts: several pigs", "says": "typing a different value makes it that pig's own … (after changes: \"2 pigs · 1 adjusted\")" },
                        { "src": "PRD", "at": "health-record Rules", "says": "Treatment never implies identical doses across pigs." }
                      ],
                      "visible": [
                        { "screen": "health-record.treatment-batch" },
                        { "text": { "en": "2 pigs · 1 adjusted", "zh": "2 头 · 1 头已调整" }, "in": "sheet" },
                        { "text": "Save · 2 pigs", "in": "sheet" }
                      ]
                    }
                  ]
                },
                {
                  "type": "action", "id": "hr-t4.remove", "label": "Open Dose per pig, Remove pigs, remove 000254, then Back",
                  "taps": ["[data-action=\"pig-doses-open\"]", "[data-action=\"dose-remove-mode\"][data-value=\"on\"]", "[data-action=\"dose-remove\"][data-value=\"000254\"]",
                           { "expect": [{ "el": "[data-action=\"dose-remove\"]", "is": "absent", "says": "the last pig cannot be removed, so remove mode ends" }] },
                           "[data-action=\"back\"]"],
                  "children": [
                    {
                      "type": "outcome", "id": "hr-t4-remove-pig", "tree": "T-4",
                      "label": "Removing a pig takes it out of the treatment; the last pig cannot be removed",
                      "gwt": { "given": "A worker is recording a treatment for two pigs with a dosage set.",
                               "when": "On Dose per pig they remove one pig and go back.",
                               "then": "Remove mode ends with one pig left, and the form saves the treatment for one pig." },
                      "authority": [
                        { "src": "PRD", "at": "features/medicines, Hosts: several pigs", "says": "Remove pigs … switches the list into remove mode … the last pig cannot be removed." }
                      ],
                      "visible": [
                        { "screen": "health-record.treatment-batch" },
                        { "text": "Save · 1 pig", "in": "sheet" }
                      ]
                    }
                  ]
                },
                {
                  "type": "action", "id": "hr-t6.save", "label": "Tap Save · 2 pigs",
                  "taps": ["[data-action=\"bulk-save\"]"],
                  "children": [
                    {
                      "type": "outcome", "id": "hr-t6-saved-toast", "tree": "T-6",
                      "label": "Saving lands on the walk list, where a toast says what was recorded and for how many pigs",
                      "gwt": { "given": "A worker has set a dosage for two pigs on Record treatment.",
                               "when": "They tap Save.",
                               "then": "The form closes onto the walk list and a message says the treatment was recorded for 2 pigs." },
                      "authority": [
                        { "src": "RUL", "at": "Design law: Feedback after saving (owner, 2026-10-18)", "says": "The result is not visible: a Toast, what was done and for whom" }
                      ],
                      "visible": [
                        { "el": "[data-bulk-key=\"dose\"]", "is": "absent", "says": "the form has closed" },
                        { "text": { "en": "Treatment recorded", "zh": "治疗已记录" }, "in": "phone" },
                        { "text": { "en": "2 pigs", "zh": "2 头猪" }, "in": "phone" }
                      ]
                    }
                  ]
                },
                {
                  "type": "action", "id": "hr-t5.leave-reopen", "label": "Back out of the form, then open Record treatment again",
                  "taps": ["[data-action=\"back\"]",
                           { "expect": [{ "el": "[data-bulk-key=\"dose\"]", "is": "absent", "says": "the form has closed" }] },
                           "[data-action=\"treatment\"]"],
                  "children": [
                    {
                      "type": "outcome", "id": "hr-t5-draft-survives-reopen", "tree": "T-5",
                      "label": "The treatment draft survives leaving the form and reopening it",
                      "gwt": { "given": "A worker has picked Tulathromycin and typed a dosage of 2.5 for two pigs.",
                               "when": "They go Back out of the form and open Record treatment again for the same pigs.",
                               "then": "The form still has Tulathromycin and the 2.5 dosage." },
                      "authority": [
                        { "src": "RUL", "at": "Owner ruling B, 2026-10-16 (drawer levels)", "says": "Footer Back keeps the draft" }
                      ],
                      "visible": [
                        { "screen": "health-record.treatment-batch" },
                        { "text": "Tulathromycin", "in": "sheet", "hard": "lost-draft" },
                        { "el": "[data-bulk-key=\"dose\"][value=\"2.5\"]", "is": "present", "says": "the dosage is kept", "hard": "lost-draft" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
