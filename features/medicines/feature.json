        "purpose": "One list of the category's medicines; a tap picks one and closes.",
        "elements": [
          {
            "name": "Medicine row",
            "at": "Amoxicillin",
            "shows": "The medicine's name, no second line",
            "states": [
              {
                "state": "Starting list",
                "when": "From the catalogue",
                "shows": "Its name in the worker's language"
