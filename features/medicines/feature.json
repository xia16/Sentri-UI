{
  "id": "medicines",
  "name": "Medicines",
  "zh": "药品",
  "platform": "mobile",
  "section": "health",
  "newFeature": true,
  "duplicates": "The old Figma (健康与治疗) has no medicine list: a drug name is typed on each treatment. Before this feature, Record treatment's medicine picker (health-record.medicine-picker) held a placeholder catalogue and a Brand field with sample brands.",
  "groups": [
    [
      "Choose",
      [
        "medicines.picker",
        "medicines.picker-first",
        "medicines.category",
        "medicines.search",
        "medicines.vaccines"
      ]
    ],
    [
      "Add",
      [
        "medicines.search-none",
        "medicines.add",
        "medicines.add-category"
      ]
    ],
    [
      "Manage",
      [
        "medicines.page",
        "medicines.page-category",
        "medicines.medicine",
        "medicines.medicine-withdrawal",
        "medicines.medicine-farm",
        "medicines.brand",
        "medicines.brand-detail",
        "medicines.rename",
        "medicines.delete"
      ]
    ]
  ],
  "entryPoints": [
    {
      "section": "Health & treatments",
      "label": "Record treatment, Medicine field",
      "from": "health-record.treatment",
      "control": "Medicine",
      "lands": "medicines.picker"
    },
    {
      "section": "Health & treatments",
      "label": "Record treatment for several pigs, Medicine field",
      "from": "health-record.treatment-batch",
      "control": "Medicine",
      "lands": "medicines.picker"
    },
    {
      "section": "Pigs",
      "label": "A vaccination task on a pig, Vaccine field",
      "from": "pig-profile.tasks",
      "control": "Vaccination → Vaccine",
      "lands": "medicines.vaccines"
    },
    {
      "section": "Home",
      "label": "Toolbox",
      "from": "workbench.toolbox",
      "control": "Medicines",
      "lands": "medicines.page"
    }
  ],
  "addsTo": [
    {
      "feature": "workbench",
      "what": "A Medicines row (the farm's medicine list: its brands, and rename and delete what the farm added)",
      "screen": "workbench.toolbox",
      "open": "Toolbox",
      "under": "Tools",
      "added": false
    },
    {
      "feature": "health-record",
      "what": "The Medicine field of Record treatment and Record vaccination opens this picker; Method and unit are pre-filled from the medicine's last use; Brand is an optional row from the farm's brands for that medicine",
      "screen": "health-record.treatment",
      "open": "Medicine",
      "under": "Record treatment",
      "added": true
    }
  ],
  "flow": [
    [
      "medicines.picker",
      "medicines.category",
      "tap a category"
    ],
    [
      "medicines.picker",
      "medicines.search",
      "type in Search"
    ],
    [
      "medicines.category",
      "medicines.search",
      "type in Search (all categories)"
    ],
    [
      "medicines.search",
      "medicines.search-none",
      "type a name with no match"
    ],
    [
      "medicines.search-none",
      "medicines.add",
      "tap Add “…”"
    ],
    [
      "medicines.add",
      "medicines.add-category",
      "tap Category"
    ],
    [
      "medicines.page",
      "medicines.page-category",
      "tap a category"
    ],
    [
      "medicines.page-category",
      "medicines.medicine",
      "tap a medicine"
    ],
    [
      "medicines.page-category",
      "medicines.medicine-farm",
      "tap a medicine the farm added"
    ],
    [
      "medicines.medicine",
      "medicines.brand",
      "tap a brand"
    ],
    [
      "medicines.brand",
      "medicines.rename",
      "tap Rename"
    ],
    [
      "medicines.brand",
      "medicines.delete",
      "tap Delete"
    ],
    [
      "medicines.medicine",
      "medicines.medicine-withdrawal",
      "tap Default withdrawal"
    ],
    [
      "medicines.brand",
      "medicines.brand-detail",
      "tap Withdrawal"
    ]
  ],
  "screens": [
    {
      "id": "medicines.picker",
      "name": "Choose a medicine: recent, then categories",
      "zh": "选择药品：最近使用与分类",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "profile-full",
      "steps": [
        "[data-action=\"pig-actions\"]",
        "[data-action=\"treatment\"]",
        "[data-action=\"medicine-open\"]"
      ],
      "figma": "",
      "notes": {
        "purpose": "Pick what was given, over the real Record treatment page: search, the farm's recent medicines, then the categories.",
        "elements": [
          {
            "name": "Recently used",
            "at": "Recently used",
            "shows": "Up to three medicines the farm picked last, under the group label Recently used; no second line",
            "states": [
              {
                "state": "Recent picks",
                "when": "The farm has recorded a treatment",
                "shows": "The medicine's name"
              },
              {
                "state": "None",
                "when": "Nothing recorded yet, or none fits the task",
                "shows": "The block is absent; the categories lose their label (medicines.picker-first)"
              }
            ],
            "logic": "Distinct, newest first, any worker, filtered to the task (a vaccination shows vaccines only). A deleted medicine leaves it.",
            "source": "medRecents(c)"
          },
          {
            "name": "Category rows",
            "at": "Categories",
            "shows": "The fixed category list, the same on every farm; no second line",
            "rule": "A tap opens the category as a level; the footer Back comes back here, the ✕ closes the picker."
          }
        ],
        "controls": [],
        "copy": [
          "medicines.title",
          "medicines.group.recent",
          "medicines.group.categories",
          "ds.picker.search"
        ],
        "issues": [
          "The categories and medicines are the starting list every farm gets (medicines-catalogue.json): to be checked by a vet.",
          "Brands, recent picks and remembered methods are sample farm data."
        ]
      }
    },
