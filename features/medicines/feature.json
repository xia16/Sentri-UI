      "notes": {
        "purpose": "Results from every category, each with its category as the second line.",
        "elements": [
          {
            "name": "Result row",
            "at": "Tylosin",
            "shows": "Medicine, with its category as meta",
            "logic": "Search mixes categories, so the category is what tells two results apart. Matches the English and Chinese names and common other names (PRRS: blue ear; PCV2: circovirus). In a vaccination only vaccines are searched, and the meta is dropped (one category)."
          }
        ],
        "controls": [],
