              {
                "state": "Added on the farm",
                "when": "Added from a search",
                "shows": "The name as typed (Gamithromycin)"
              },
              {
                "state": "Current pick",
                "when": "Already set on the form",
                "shows": "Ink ✓"
              }
            ]
          },
          {
            "name": "Search",
            "at": "[data-medicine-search]",
            "shows": "Search all options",
            "rule": "Searches every category from here; while it has text the head names the root (Medicines). The footer Back goes up to Medicines."
          }
        ],
        "controls": [],
        "copy": [],
        "issues": [
          "The categories and medicines are the starting list every farm gets (medicines-catalogue.json): to be checked by a vet."
