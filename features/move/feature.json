    {
      "id": "move.tagged",
      "name": "Which pigs",
      "zh": "选择猪只",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "walk",
      "steps": [
        "[data-action=\"pen-detail\"][data-value=\"D4\"]",
        "[data-action=\"pen-move\"]"
      ],
      "figma": "",
      "notes": {
        "purpose": "Move from a pen: say which pigs go. Shown only when the pen holds more than one pig or pigs without ID; one tagged pig goes straight to To pen.",
        "elements": [
          {
            "name": "With ID",
            "shows": "The pen's tagged pigs behind the search with scan, ticked by ID, \"0 of 2\"",
            "logic": "Farrowing's Send piglets parts: a read ticks."
          },
          {
            "name": "Without ID",
            "shows": "A count \"of 14\" when the pen has pigs without ear tags; its hint \"Moving clears their conditions.\" when that group has conditions",
            "logic": "Conditions on pigs without ID are on a number, not on pigs: the moved ones arrive with none (owner, 2026-11-16)."
          }
        ],
        "controls": [
          {
            "control": "Choose pen",
            "does": "opens To pen; off until a pig is ticked or counted",
            "goesTo": "move.picker"
          },
          {
            "control": "Back",
            "does": "back to the pen; nothing moved",
            "goesTo": "inspection.pen"
          }
        ],
        "copy": [
          "Move pigs",
          "From D4 · Unit 7",
          "With ID",
          "Without ID",
          "of 14",
          "Moving clears their conditions.",
          "Choose pen"
        ],
        "rules": [
          "Owner, 2026-11-09: Move is the ad hoc move; Transfer is a planned task sent only from the console.",
          "Owner, 2026-11-16: one Move everywhere, one pig or many pigs, with or without ID."
        ]
      }
    },
