{
  "id": "move",
  "name": "Move",
  "zh": "转舍",
  "platform": "mobile",
  "section": "measures",
  "newFeature": false,
  "duplicates": "",
  "groups": [
    [
      "Inspection Move",
      [
        "move.which-pigs",
        "move.counts",
        "move.tagged",
        "move.mixed",
        "move.rooms",
        "move.whole-room",
        "move.picker",
        "move.after"
      ]
    ],
    [
      "From a sow record",
      [
        "move.transfer-sow"
      ]
    ]
  ],
  "screens": [
    {
      "id": "move.which-pigs",
      "name": "Choose pigs in a pen",
      "zh": "选择猪只",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "walk",
      "steps": [
        "[data-action=\"pen-detail\"][data-value=\"D4\"]",
        "[data-action=\"pen-move\"][data-value=\"D4\"]"
      ],
      "figma": "https://www.figma.com/design/4GZGPBauEOWQQjnRrzoUgF?node-id=60-408",
      "notes": {
        "rules": [
          "Choose by ear tag or ear notch. A scan can tick a pig housed in this pen. Enter the head count for pigs without either identity.",
          "When all but one pig are absent and there is no untagged group, start at the destination."
        ]
      }
    },
    {
      "id": "move.counts",
      "name": "Allocate selected head by batch",
      "zh": "各批次转舍头数",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus&moveFixture=batches",
      "preset": "walk",
      "steps": [
        "[data-pig-select=\"000254\"]",
        "[data-action=\"notags-count-open\"][data-value=\"D4\"]",
        "[data-action=\"notags-pad\"][data-key=\"5\"]",
        "[data-action=\"notags-count-done\"]",
        "[data-action=\"actions\"]",
        "[data-action=\"transfer\"]"
      ],
      "figma": "",
      "notes": {
        "rules": [
          "A partial selection of a multi-batch group must specify the head count by batch. The sum matches the count selected in Inspection."
        ]
      }
    },
    {
      "id": "move.tagged",
      "name": "Move · one identified pig",
      "zh": "转舍 · 单猪",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "walk",
      "steps": [
        "[data-action=\"pig\"][data-value=\"000267\"]",
        "[data-action=\"pig-actions\"]",
        "[data-action=\"transfer\"]"
      ],
      "figma": "https://www.figma.com/design/4GZGPBauEOWQQjnRrzoUgF?node-id=60-408",
      "notes": {
        "rules": [
          "The pig’s record supplies the source. Choose a pen by code or from the standard PenMap Sheet when the room has a layout."
        ]
      }
    },
    {
      "id": "move.mixed",
      "name": "Move · identified pigs and counted head",
      "zh": "转舍 · 混选",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "walk",
      "steps": [
        "[data-action=\"pen-detail\"][data-value=\"D4\"]",
        "[data-action=\"pen-move\"][data-value=\"D4\"]",
        "input[data-action=\"move-pig\"][value=\"000801\"]",
        "[data-action=\"move-count-open\"][data-value=\"D4|0\"]",
        "[data-action=\"move-number\"][data-key=\"5\"]",
        "[data-action=\"move-number-done\"]",
        "[data-action=\"move-next\"]"
      ],
      "figma": "",
      "notes": {
        "rules": [
          "Choose a room, then find the pen by code or open the standard PenMap Sheet. The source pens are disabled. Selecting a pen opens Review move."
        ]
      }
    },
    {
      "id": "move.rooms",
      "name": "Choose a room",
      "zh": "选择房间",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "walk",
      "steps": [
        "[data-action=\"pen-detail\"][data-value=\"D4\"]",
        "[data-action=\"pen-move\"][data-value=\"D4\"]",
        "input[data-action=\"move-pig\"][value=\"000801\"]",
        "[data-action=\"move-count-open\"][data-value=\"D4|0\"]",
        "[data-action=\"move-number\"][data-key=\"5\"]",
        "[data-action=\"move-number-done\"]",
        "[data-action=\"move-next\"]",
        "[data-action=\"move-choose-room\"]"
      ],
      "figma": "",
      "notes": {
        "rules": [
          "Room list groups by section and pins the source room. It can be searched by room or section."
        ]
      }
    },
    {
      "id": "move.whole-room",
      "name": "PenMap Sheet · Whole room",
      "zh": "整栋选栏",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus&penmap=long",
      "preset": "walk",
      "steps": [
        "[data-action=\"pen-detail\"][data-value=\"D4\"]",
        "[data-action=\"pen-move\"][data-value=\"D4\"]",
        "input[data-action=\"move-pig\"][value=\"000801\"]",
        "[data-action=\"move-count-open\"][data-value=\"D4|0\"]",
        "[data-action=\"move-number\"][data-key=\"5\"]",
        "[data-action=\"move-number-done\"]",
        "[data-action=\"move-next\"]",
        "[data-action=\"move-open-map\"]",
        ".st-pen-whole-toggle"
      ],
      "figma": "",
      "notes": {
        "rules": [
          "Select a range in Whole room to return to individual pens in that part of the room. This does not commit the move."
        ]
      }
    },
    {
      "id": "move.picker",
      "name": "Review move",
      "zh": "核对转舍",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "walk",
      "steps": [
        "[data-action=\"pen-detail\"][data-value=\"D4\"]",
        "[data-action=\"pen-move\"][data-value=\"D4\"]",
        "input[data-action=\"move-pig\"][value=\"000801\"]",
        "[data-action=\"move-count-open\"][data-value=\"D4|0\"]",
        "[data-action=\"move-number\"][data-key=\"5\"]",
        "[data-action=\"move-number-done\"]",
        "[data-action=\"move-next\"]",
        "[data-action=\"move-pen\"][data-value=\"C4\"]"
      ],
      "figma": "https://www.figma.com/design/4GZGPBauEOWQQjnRrzoUgF?node-id=60-408",
      "notes": {
        "rules": [
          "The source pigs and counts and the selected destination are shown before submission. Tap the destination row to change it. Back cancels the change and keeps the previous target.",
          "A server error is shown using the ordinary notice toast while the move stays on the review page."
        ]
      }
    },
    {
      "id": "move.after",
      "name": "Move recorded · back on the pen",
      "zh": "转舍完成 · 回到来源栏",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "walk",
      "steps": [
        "[data-action=\"pen-detail\"][data-value=\"D4\"]",
        "[data-action=\"pen-move\"][data-value=\"D4\"]",
        "input[data-action=\"move-pig\"][value=\"000801\"]",
        "[data-action=\"move-count-open\"][data-value=\"D4|0\"]",
        "[data-action=\"move-number\"][data-key=\"5\"]",
        "[data-action=\"move-number-done\"]",
        "[data-action=\"move-next\"]",
        "[data-action=\"move-pen\"][data-value=\"C4\"]",
        "[data-action=\"move-save\"]"
      ],
      "figma": "https://www.figma.com/design/4GZGPBauEOWQQjnRrzoUgF?node-id=60-408",
      "notes": {
        "rules": [
          "The count changes in both pens and each pen log gains a movement record. A concise toast names the destination."
        ]
      }
    },
    {
      "id": "move.transfer-sow",
      "name": "Move sow · from a Farrowing record",
      "zh": "母猪转舍",
      "status": "in-design",
      "url": "/ux/system/farrowing-astra-concept.html?layout=focus",
      "preset": "count",
      "steps": [
        "[data-action=\"sowActions\"]",
        "[data-action=\"sow-host-action\"][data-value=\"transfer\"]"
      ],
      "figma": "",
      "notes": {
        "purpose": "Open the shared destination picker for this sow from her own Farrowing Actions.",
        "rules": [
          "The source crate is disabled. Choose a room or type a pen code. The commit names the unit and pen.",
          "The sow returns to her record after the move, with her new location."
        ]
      }
    }
  ],
  "flow": [
    [
      "move.which-pigs",
      "move.mixed",
      "choose pigs and continue"
    ],
    [
      "move.counts",
      "move.mixed",
      "confirm the split"
    ],
    [
      "move.tagged",
      "move.rooms",
      "choose a room"
    ],
    [
      "move.mixed",
      "move.whole-room",
      "open the PenMap Sheet and tap Whole room in a long room"
    ],
    [
      "move.mixed",
      "move.picker",
      "choose a pen"
    ],
    [
      "move.picker",
      "move.after",
      "commit from a pen"
    ]
  ],
  "entryPoints": [
