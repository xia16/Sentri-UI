              "id": "ds-c9-manual-conflict-contract.act",
              "label": "The worker compares both values and retries the conflict.",
              "taps": [
                "[data-action=\"open-record\"][data-value=\"first\"]",
                {
                  "expect": [
                    {
                      "text": {
                        "en": "Compare before retrying",
                        "zh": "重试前核对差异"
                      }
                    },
                    {
                      "text": {
                        "en": "Pregnancy result: Pregnant",
                        "zh": "孕检结果：已怀孕"
                      }
                    },
                    {
                      "text": {
                        "en": "Pregnancy result: Not pregnant",
                        "zh": "孕检结果：未怀孕"
                      }
                    }
                  ]
                },
                "[data-action=\"retry\"]",
                {
                  "wait": 800
                }
              ],
              "children": [
                {
                  "type": "outcome",
                  "id": "ds-c9-manual-conflict-contract",
                  "tree": "C-9",
                  "label": "Conflict retry never overwrites the server",
                  "gwt": {
                    "given": "The saved result differs from the current team record.",
                    "when": "The worker compares both values and manually retries.",
                    "then": "The server record is not overwritten and this record remains in conflict."
                  },
                  "authority": [
                    {
                      "src": "PRD",
                      "at": "Decisions 2026-10-12",
                      "says": "Show both values before retry; retry cannot overwrite the server."
