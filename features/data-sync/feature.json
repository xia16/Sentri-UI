  "flow": [
    [
      "data-sync.banner",
      "data-sync.list",
      "tap local records"
    ],
    [
      "data-sync.global-upload",
      "data-sync.list",
      "tap app-shell upload status"
    ],
    [
      "data-sync.global-error",
      "data-sync.failed",
      "tap app-shell exception status"
    ],
    [
      "data-sync.task-badge",
      "data-sync.task-list",
      "open task-owned records"
    ],
    [
      "data-sync.task-list",
      "data-sync.list",
      "view all records on this phone"
    ],
    [
      "data-sync.grouped",
      "data-sync.category",
      "open work category"
    ],
    [
      "data-sync.list",
      "data-sync.detail",
