    ],
    [
      "data-sync.list",
      "data-sync.failed",
      "one record fails"
    ],
    [
      "data-sync.list",
      "data-sync.conflict",
      "server conflict"
    ],
    [
      "data-sync.list",
      "data-sync.blocked",
      "earlier operation unresolved"
    ],
    [
      "data-sync.list",
      "data-sync.upload",
      "all local work uploaded"
    ],
    [
      "data-sync.list",
      "data-sync.receipt",
      "local response missing"
    ],
    [
      "data-sync.receipt",
