{
  "id": "data-sync",
  "name": "Data sync",
  "zh": "数据同步",
  "platform": "mobile",
  "section": "sync",
  "newFeature": false,
  "duplicates": "",
  "groups": [
    [
      "本机记录",
      [
        "data-sync.banner",
        "data-sync.global-upload",
        "data-sync.global-error",
        "data-sync.task-badge",
        "data-sync.task-list",
        "data-sync.list",
        "data-sync.grouped",
        "data-sync.category",
        "data-sync.detail"
      ]
    ],
    [
      "异常与结果",
      [
        "data-sync.failed",
        "data-sync.conflict",
        "data-sync.blocked",
        "data-sync.dependent-delete",
        "data-sync.upload",
        "data-sync.receipt",
        "data-sync.reconciled",
        "data-sync.switch",
        "data-sync.auth"
      ]
    ]
  ],
  "screens": [
    {
      "id": "data-sync.banner",
      "name": "Home saved-work entry",
      "zh": "首页本机记录入口",
      "status": "in-design",
      "notes": {
        "purpose": "原生应用壳在状态栏安全区下的现有页眉右侧悬浮全局本机记录徽标，不增加整行卡片；异常徽标展开文字，点击进入同一数据同步页。",
        "states": [
          {
            "state": "Waiting",
            "when": "本机有待上传记录",
            "shows": "页眉徽标报这台手机待上传数；恢复网络后自动上传，首页不重复同步卡"
          },
          {
            "state": "Needs attention",
            "when": "有失败或冲突",
            "shows": "异常标识、全机未上传总数和查看入口"
          },
          {
            "state": "Empty",
            "when": "本机无待上传记录",
            "shows": "全局入口隐藏；总览仍可说明本机暂无待上传记录，不能称团队全部记录已齐"
          }
        ],
        "issues": [
          "Home fixture 与新数据同步页仍是各自样例；未接真实队列。"
        ]
      },
      "url": "/ux/system/home-astra-prototype.html?section=gestation&connection=offline"
    },
    {
      "id": "data-sync.global-upload",
      "name": "Uploading outside Home",
      "zh": "其他页面感知正在上传",
      "status": "in-design",
      "url": "/ux/system/home-astra-prototype.html?section=gestation&connection=online",
      "steps": [
        {
          "tap": "[data-action=\"toolbox\"]"
        }
      ],
      "notes": {
        "purpose": "工人进入工具箱后仍可看见应用壳的自动上传状态，并能点入同一同步总览。",
        "issues": [
          "Home 样例只证明应用壳布局；其他功能原型尚未接入同一壳。"
        ]
      }
    },
    {
      "id": "data-sync.global-error",
      "name": "Exception outside Home",
      "zh": "其他页面感知同步异常",
      "status": "in-design",
      "url": "/ux/system/home-astra-prototype.html?section=gestation&sync=failed",
      "steps": [
        {
          "tap": "[data-action=\"toolbox\"]"
        }
      ],
      "notes": {
        "purpose": "离开首页后仍显示需要处理的本机记录数；点击进入异常详情。",
        "issues": [
          "真实队列与其他功能页面需要 Android 实现时连接。"
        ]
      }
    },
    {
      "id": "data-sync.task-badge",
      "name": "Task-owned saved work in Farrowing",
      "zh": "分娩任务页眉本任务记录入口",
      "status": "in-design",
      "url": "/ux/system/farrowing-astra-concept.html?layout=focus&taskSync=offline",
      "notes": {
        "purpose": "分娩任务页眉尾部显示本任务实例未上传数；任务总览与下级作业页共用范围，点开任务记录。",
        "states": [
          {
            "state": "Waiting",
            "when": "本次任务有待上传记录",
            "shows": "Task 2；读屏解释保存在本机并等待上传"
          },
          {
            "state": "Uploading",
            "when": "本次任务正在自动上传",
            "shows": "Task 2 与上传中状态"
          },
          {
            "state": "Needs attention",
            "when": "本次任务有失败记录",
            "shows": "Task 2 与异常状态"
          },
          {
            "state": "Other-task records only",
            "when": "本任务无待传，但本机其他任务仍有记录",
            "shows": "明确标 All 3，点击进入全机列表；不误报为本任务 3 条"
          }
        ],
        "issues": [
          "本机样例不与 Home 或真实 Android 队列共享；其他任务原型的页眉尚未接入。"
        ]
      }
    },
    {
      "id": "data-sync.task-list",
      "name": "Records from this task",
      "zh": "本任务记录列表",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=offline&taskId=farrow28&from=task",
      "notes": {
        "purpose": "只显示稳定任务实例 farrow28 下跨单元/栏位的未上传记录，提供本机全部记录入口。",
        "issues": [
          "真实 taskId 和每条离线操作的归属需在 Android 业务功能与队列交接时接通。"
        ]
      }
    },
    {
      "id": "data-sync.list",
      "name": "Saved work (sync list)",
      "zh": "数据同步列表",
      "status": "in-design",
      "notes": {
        "purpose": "本机记录总览。异常与待上传记录逐条呈现；已确认上传仅显示近30天总数，不铺历史记录行。",
        "states": [
          {
            "state": "Offline",
            "when": "无网络",
            "shows": "保留本机记录，说明网络恢复后自动上传"
          },
          {
            "state": "Syncing",
            "when": "网络可用且自动发送中",
            "shows": "同步中，可离开页面"
          },
          {
            "state": "Partial",
            "when": "部分记录已同步",
            "shows": "已上传显示近30天总数，未解决记录仍逐条可见"
          },
          {
            "state": "Recent history",
            "when": "已确认上传记录跨越30天期限",
            "shows": "仅期限内记录计入本机已上传合计；过期且无未上传依赖的本机副本可清理"
          }
        ],
        "issues": [
          "样例未接入其他功能原型的真实操作。"
        ]
      },
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=offline"
    },
    {
      "id": "data-sync.detail",
      "name": "Sync detail",
      "zh": "数据同步-详情",
      "status": "in-design",
      "notes": {
        "purpose": "单条本机记录的身份、状态、保存时间、错误原因与安全恢复。",
        "states": [
          {
            "state": "Failed",
            "when": "服务端未处理",
            "shows": "保留本机记录与重试入口"
          },
          {
            "state": "Conflict",
            "when": "服务端状态冲突",
            "shows": "停止自动同步；可人工重试或经确认删除"
          },
          {
            "state": "Blocked",
            "when": "前置操作未解决",
            "shows": "指出阻断原因，不显示为已发送"
          }
        ],
        "issues": [
          "真实服务端差异获取与条件写入需 Android/后端契约验证。"
        ]
      },
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=conflict",
      "steps": [
        {
          "tap": "[data-action=\"open-record\"]"
        }
      ]
    },
    {
      "id": "data-sync.grouped",
      "name": "Many saved records by work category",
      "zh": "大量本机记录按类别汇总",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=busy",
      "notes": {
        "purpose": "30 条样例中需要处理的记录直接可见，普通待传按业务类别汇总。",
        "issues": [
          "样例仅覆盖分散在四类中的记录；真实类别和任务类型由业务数据提供。"
        ],
        "states": [
          {
            "state": "Threshold",
            "when": "九条待传跨两类，浏览中自动确认一条",
            "shows": "分类入口保留、待传数更新为八；重新进入才重判布局。可用 scenario=threshold 验证。"
          }
        ]
      }
    },
    {
      "id": "data-sync.category",
      "name": "Saved records within a category",
      "zh": "类别内查看本机记录",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=busy",
      "steps": [
        {
          "tap": "[data-action=\"open-category\"][data-value=\"production\"]"
        }
      ],
      "notes": {
        "purpose": "点入业务类别后直接看到本机记录，可逐条打开并返回；不强制再走任务类型和任务两级。"
      }
    },
    {
      "id": "data-sync.upload",
      "name": "All uploaded on this phone",
      "zh": "本机暂无待上传",
      "status": "in-design",
      "notes": {
        "purpose": "本机无待处理队列；仅显示近30天已上传总数，不列逐条历史。",
        "states": [
          {
            "state": "Empty",
            "when": "待上传及异常都为零",
            "shows": "仅声明本机暂无待上传记录，并附上近30天已上传合计；不推断团队数据完整"
          }
        ]
      },
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=done"
    },
    {
      "id": "data-sync.failed",
      "name": "Partial upload and failure",
      "zh": "部分上传与失败",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=partial",
      "notes": {
        "purpose": "逐条结果与失败恢复。",
        "states": [
          {
            "state": "Partial",
            "when": "三条中两条成功一条失败",
            "shows": "成功的已上传，失败的留在本机，可查看原因并重试"
          }
        ]
      }
    },
    {
      "id": "data-sync.receipt",
      "name": "Checking a missing receipt",
      "zh": "核对丢失回执",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=uncertain&receipt=hold",
      "notes": {
        "purpose": "请求可能已由服务端处理但本机未收到回执时，按原操作 ID 查询；查询期间保留本机记录，暂不重发。",
        "issues": [
          "原型使用本地定时结果；Android/后端交接时核对查询接口与回执结构。"
        ]
      }
    },
    {
      "id": "data-sync.reconciled",
      "name": "Receipt confirmed by server",
      "zh": "服务端确认已处理",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=uncertain&receipt=resolved",
      "notes": {
        "purpose": "按操作 ID 查到服务端已处理后才将本机记录标为已上传，不再次发送。",
        "issues": [
          "原型为本地样例，不代表真实查询接口已接入。"
        ]
      }
    },
    {
      "id": "data-sync.conflict",
      "name": "Conflict awaiting manual action",
      "zh": "冲突待人工处理",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=conflict",
      "notes": {
        "purpose": "冲突停止自动同步，可查看详情、人工重试或确认删除。",
        "issues": [
          "交互样例未接真实账号、猪场或服务端数据。"
        ]
      }
    },
    {
      "id": "data-sync.blocked",
      "name": "Later operation blocked",
      "zh": "后续操作受阻",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=blocked",
      "notes": {
        "purpose": "前置操作失败时，后续操作保留在本机并明确说明原因。",
        "issues": [
          "交互样例未接真实账号、猪场或服务端数据。"
        ]
      }
    },
    {
      "id": "data-sync.dependent-delete",
      "name": "Blocked after predecessor deletion",
      "zh": "前置删除后续受阻",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=conflict",
      "steps": [
        {
          "tap": "[data-action=\"open-record\"][data-value=\"first\"]"
        },
        {
          "tap": "[data-action=\"ask-delete\"]"
        },
        {
          "tap": "[data-action=\"confirm-delete\"]"
        },
        {
          "tap": "[data-action=\"open-record\"][data-value=\"second\"]"
        }
      ],
      "notes": {
        "purpose": "前置冲突已删除；后续记录只可查看或经确认逐条删除，不自动发送或重试。",
        "issues": [
          "样例未接真实依赖队列；所有直接与间接依赖项都需按同一规则处理。"
        ]
      }
    },
    {
      "id": "data-sync.switch",
      "name": "Account or farm switch blocked",
      "zh": "切换账号或猪场受阻",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=switch",
      "notes": {
        "purpose": "有未上传记录时阻止切换并引导处理。",
        "issues": [
          "交互样例未接真实账号、猪场或服务端数据。"
        ]
      }
    },
    {
      "id": "data-sync.auth",
      "name": "Original account sign-in needed",
      "zh": "原账号登录后续传",
      "status": "in-design",
      "url": "/ux/system/data-sync-astra-prototype.html?scenario=expired",
      "notes": {
        "purpose": "登录失效时暂停发送并保留原账号/猪场绑定。重新登录原账号后自动续传。",
        "issues": [
          "样例点击只模拟原账号验证成功；真实凭证验证由账号流程提供。"
        ]
      }
    }
  ],
  "flow": [
    [
      "data-sync.banner",
      "data-sync.list",
      "tap local records"
    ],
    [
      "data-sync.global-upload",
      "data-sync.list",
      "tap app-shell upload status"
    ],
    [
      "data-sync.global-error",
      "data-sync.failed",
      "tap app-shell exception status"
    ],
    [
      "data-sync.task-badge",
      "data-sync.task-list",
      "open task-owned records"
    ],
    [
      "data-sync.task-list",
      "data-sync.list",
      "view all records on this phone"
    ],
    [
      "data-sync.grouped",
      "data-sync.category",
      "open work category"
    ],
    [
      "data-sync.list",
      "data-sync.detail",
      "open a record"
    ],
    [
      "data-sync.list",
      "data-sync.failed",
      "one record fails"
    ],
    [
      "data-sync.list",
      "data-sync.conflict",
      "server conflict"
    ],
    [
      "data-sync.list",
      "data-sync.blocked",
      "earlier operation unresolved"
    ],
    [
      "data-sync.list",
      "data-sync.upload",
      "all local work uploaded"
    ],
    [
      "data-sync.list",
      "data-sync.receipt",
      "local response missing"
    ],
    [
      "data-sync.receipt",
      "data-sync.reconciled",
      "query by operation ID confirms the original request"
    ],
    [
      "data-sync.list",
      "data-sync.switch",
      "request account or farm switch with unsent work"
    ],
    [
      "data-sync.list",
      "data-sync.auth",
      "session expires with unsent records"
    ],
    [
      "data-sync.conflict",
      "data-sync.dependent-delete",
      "delete conflicted predecessor with dependent records"
    ]
  ],
  "entryPoints": [
    {
      "section": "Home",
      "label": "via the saved-work card",
      "from": "workbench.today",
      "control": "Saved-work card",
      "lands": "data-sync.list"
    },
    {
      "section": "Farrowing task",
      "label": "via this-task header badge",
      "from": "farrowing.room",
      "control": "Task 2",
      "lands": "data-sync.task-list"
    }
  ]
}
