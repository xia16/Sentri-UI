{
  "id": "disease",
  "name": "Disease and symptom",
  "zh": "疾病与症状",
  "platform": "mobile",
  "section": "health",
  "newFeature": false,
  "duplicates": "",
  "groups": [
    [
      "Add a condition",
      [
        "disease.add-select",
        "disease.add-drawer",
        "disease.catalogue",
        "disease.catalogue-area",
        "disease.catalogue-add",
        "disease.add-ready",
        "disease.add-committed"
      ]
    ],
    [
      "Resolve",
      [
        "disease.resolve-one",
        "disease.resolve-many",
        "disease.resolve-outcome",
        "disease.resolve-in-place",
        "disease.resolve-committed"
      ]
    ]
  ],
  "entryPoints": [
    {
      "section": "Inspection",
      "label": "Pigs ticked on the walk: Actions",
      "from": "inspection.walk",
      "control": "Actions",
      "lands": "disease.add-select"
    },
    {
      "section": "Pigs",
      "label": "One pig: Actions on its record",
      "from": "pig-profile.full",
      "control": "Actions → Resolve",
      "lands": "disease.resolve-one"
    }
  ],
  "screens": [
    {
      "id": "disease.add-select",
      "name": "Two pigs ticked · Actions",
      "zh": "已选两头 · 操作",
      "aliasOf": "inspection.actions"
    },
    {
      "id": "disease.add-drawer",
      "name": "Record health · two pigs",
      "zh": "记录健康 · 两头",
      "aliasOf": "health-record.record-health",
      "preset": "selected",
      "steps": [
        "[data-action=\"health\"]"
      ]
    },
    {
      "id": "disease.catalogue",
      "name": "Choose conditions",
      "zh": "选择病症",
      "aliasOf": "health-record.condition-picker",
      "preset": "selected",
      "steps": [
        "[data-action=\"health\"]",
        "[data-action=\"bulk-pick-health\"]"
      ]
    },
    {
      "id": "disease.catalogue-area",
      "name": "Choose conditions · a body area",
      "zh": "选择病症 · 部位",
      "aliasOf": "health-record.condition-picker",
      "preset": "selected",
      "steps": [
        "[data-action=\"health\"]",
        "[data-action=\"bulk-pick-health\"]",
        "[data-action=\"condition-level\"][data-value=\"g:breathing\"]"
      ]
    },
    {
      "id": "disease.catalogue-add",
      "name": "Add a condition",
      "zh": "添加病症",
      "aliasOf": "health-record.condition-picker",
      "preset": "selected",
      "steps": [
        "[data-action=\"health\"]",
        "[data-action=\"bulk-pick-health\"]",
        {
          "fill": "[data-v2=\"search\"]",
          "text": "Bitten ear"
        },
        "[data-action=\"condition-add\"]"
      ]
    },
    {
      "id": "disease.add-ready",
      "name": "Record health · a condition chosen",
      "zh": "记录健康 · 已选病症",
      "aliasOf": "health-record.record-health",
      "preset": "selected",
      "steps": [
        "[data-action=\"health\"]",
        "[data-action=\"bulk-pick-health\"]",
        "[data-condition=\"Coughing\"]",
        "[data-action=\"bulk-health-done\"]"
      ]
    },
    {
      "id": "disease.add-committed",
      "name": "Saved: the walk list, with the toast",
      "zh": "已保存 · 巡栏列表",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "selected",
      "steps": [
        "[data-action=\"health\"]",
        "[data-action=\"bulk-pick-health\"]",
        "[data-condition=\"Coughing\"]",
        "[data-action=\"bulk-health-done\"]",
        "[data-action=\"bulk-save\"]"
      ],
      "figma": "",
      "notes": {
        "purpose": "After Save the walk list is back: each pig's row carries the new tag, the selection clears and a toast counts the pigs.",
        "elements": [
          {
            "name": "Pig row",
            "at": "000254",
            "shows": "The new condition on the row's one line (Coughing)",
            "states": [
              {
                "state": "Newly added",
                "when": "The pig did not have it",
                "shows": "The condition joins the row, ordered by care level; No action needed prints as plain text, a care level that needs attention as its tag"
              },
              {
                "state": "Already had it",
                "when": "The condition was open on the pig",
                "shows": "No second finding; the tag keeps its start date"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "disease.resolve-one",
      "name": "Resolve · one pig",
      "zh": "康复 / 移除 · 单只",
      "aliasOf": "health-record.resolve-conditions"
    },
    {
      "id": "disease.resolve-many",
      "name": "Resolve conditions · two pigs",
      "zh": "解除病症 · 两头",
      "aliasOf": "health-record.resolve-conditions",
      "preset": "selected",
      "steps": [
        "[data-action=\"resolve\"]"
      ]
    },
    {
      "id": "disease.resolve-outcome",
      "name": "Resolve · Recovered or Entered in error",
      "zh": "解除病症 · 结果",
      "aliasOf": "health-record.resolve-conditions",
      "preset": "selected",
      "steps": [
        "[data-action=\"resolve\"]",
        "[data-action=\"open-picker\"][data-picker-key=\"target\"]",
        "[data-action=\"picker-select\"][data-value=\"Thin\"]",
        "[data-action=\"open-picker\"][data-picker-key=\"outcome\"]"
      ]
    },
    {
      "id": "disease.resolve-in-place",
      "name": "Resolve · outcome chosen",
      "zh": "解除病症 · 已选结果",
      "aliasOf": "health-record.resolve-conditions",
      "preset": "selected",
      "steps": [
        "[data-action=\"resolve\"]",
        "[data-action=\"open-picker\"][data-picker-key=\"target\"]",
        "[data-action=\"picker-select\"][data-value=\"Thin\"]",
        "[data-action=\"open-picker\"][data-picker-key=\"outcome\"]",
        "[data-action=\"picker-select\"][data-value=\"recover\"]"
      ]
    },
    {
      "id": "disease.resolve-committed",
      "name": "Resolved: the walk list, with the toast",
      "zh": "已解除 · 巡栏列表",
      "status": "in-design",
      "url": "/ux/system/inspection-astra-concept.html?layout=focus",
      "preset": "selected",
      "steps": [
        "[data-action=\"resolve\"]",
        "[data-action=\"open-picker\"][data-picker-key=\"target\"]",
        "[data-action=\"picker-select\"][data-value=\"Thin\"]",
        "[data-action=\"open-picker\"][data-picker-key=\"outcome\"]",
        "[data-action=\"picker-select\"][data-value=\"recover\"]",
        "[data-action=\"bulk-save\"]"
      ],
      "figma": "",
      "notes": {
        "purpose": "After Save the walk list is back: the resolved tag leaves the row and a toast names what was saved.",
        "elements": [
          {
            "name": "Toast",
            "at": "Marked recovered",
            "shows": "Marked recovered with the pig's ear tag",
            "states": [
              {
                "state": "Recovered",
                "when": "Outcome Recovered",
                "shows": "The tag leaves the row; the case stays in the pig's history as recovered"
              },
              {
                "state": "Entered in error",
                "when": "Outcome Entered in error",
                "shows": "The tag leaves the row; the log keeps a record correction"
              }
            ]
          }
        ]
      }
    }
  ],
  "flow": [
    [
      "disease.add-select",
      "disease.add-drawer",
      "tap Condition"
    ],
    [
      "disease.add-drawer",
      "disease.catalogue",
      "tap Conditions"
    ],
    [
      "disease.catalogue",
      "disease.catalogue-area",
      "tap a body area"
    ],
    [
      "disease.catalogue",
      "disease.catalogue-add",
      "search with no match, tap Add"
    ],
    [
      "disease.catalogue",
      "disease.add-ready",
      "tick a condition, tap Done"
    ],
    [
      "disease.add-ready",
      "disease.add-committed",
      "tap Save"
    ],
    [
      "disease.add-select",
      "disease.resolve-many",
      "tap Resolve"
    ],
    [
      "disease.resolve-many",
      "disease.resolve-outcome",
      "choose the condition, tap Outcome"
    ],
    [
      "disease.resolve-outcome",
      "disease.resolve-in-place",
      "tap Recovered"
    ],
    [
      "disease.resolve-in-place",
      "disease.resolve-committed",
      "tap Save"
    ],
    [
      "disease.resolve-one",
      "disease.resolve-committed",
      "tap Save"
    ]
  ]
}
