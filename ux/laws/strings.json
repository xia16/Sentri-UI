{
  "verbs": {
    "Back": {"meaning": "leave a screen and keep any draft on the device; pure navigation", "zh": "返回"},
    "Clear": {"meaning": "discard the draft; a text action, present only while a draft exists", "zh": "清除"},
    "Close": {"meaning": "leave a sheet that saves per tap; names the sheet, not the data", "zh": "关闭"},
    "Edit": {"meaning": "correct something already posted; stamped, original kept, corrected value amber", "zh": "修改"},
    "End task": {"meaning": "close the task for the batch; manual only, hold-to-commit, with a receipt", "zh": "结束任务"},
    "Finish": {"meaning": "end a farrowing; always written 'Finish farrowing' (the object names what ends)", "zh": "结束"},
    "Lock": {"meaning": "freeze Born at the end of farrowing; hold-to-commit", "zh": "锁定"},
    "Move": {"meaning": "move n piglets from one litter to another in one record that changes both litters", "zh": "转移"},
    "Record": {"meaning": "commit an act or observation", "zh": "记录"},
    "Save": {"meaning": "commit a staged draft as one stamped event", "zh": "保存"},
    "Scan": {"meaning": "read an ear tag with the camera", "zh": "扫描"},
    "Set count": {"meaning": "assert the head count seen; the difference is written as an unexplained gain or loss", "zh": "设定头数"}
  },
  "banned": {
    "Submit": "every action commits itself; name the act (Record, Save, End task)",
    "Confirm": "name the act instead; the DS README's 'Confirm & next' example is superseded by the rulings",
    "Complete": "rooms and tasks are ended, not completed; say End task or Finish farrowing; the DS README's 'Complete' ban stands"
  },
